@model Vstup_asp.ViewModels.DiscountViewModel

@{
    ViewData["Title"] = "Розрахуноk";
}

<div style="margin: 20px;">
    < h2>Калькулятор знижок</h2>

      <form asp-action="Index" method="post">
        <div>
            <label>Ціна товару:</label><br />
              <input type="number" step="0.01" asp-for="Price" required />
          </div>
         <br />
        <div>
            <label>Відсоток знижки (%):</label><br />
            <input type="number" step="0.01" asp-for="DiscountPercent" required />
          </div>
        <br />
          <button type="submit">Порахувати</button>
    </form>

    <hr />

    @if (Model != null && Model.Price > 0)
    {
        <div style="margin-top: 20px; padding: 10px; background-color: #f0f0f0; width: 300px;">
              <h3>Результат:</h3>
            <p>Підсумкова ціна: <b>@Model.FinalPrice грн</b></p>
              <p style="color: green;">@Model.Message</p>
        </div>
    }
</div>